{#- Админка галереи «Примеры работ»: загрузка фото, порядок, удаление. Самостоятельная страница,
    со страниц для посетителей на неё ничего не ссылается и её файлы там не подключаются.
    Логика — /assets/js/admin.js -#}
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Галерея — Tummo Room</title>
  <link rel="icon" href="/favicon.ico">
  <style>
    *{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%}
    body{margin:0;background:#171717;color:#d9c5ae;font:16px/1.4 system-ui,sans-serif}
    button,input{font:inherit;color:inherit}
    button{border:0;border-radius:10px;padding:.7em 1em;background:#2e2a26;cursor:pointer}
    button:disabled{opacity:.4;cursor:default}
    .primary{background:#d9c5ae;color:#171717;font-weight:600}
    .danger{color:#ff9a8a}
    [hidden]{display:none!important}

    .login{max-width:26rem;margin:0 auto;padding:2rem 1rem}
    .login h1{font-size:1.4rem;margin:0 0 1rem}
    .login p{color:#a89886;margin:0 0 1rem}
    .login input{width:100%;padding:.8em;border:1px solid #4a433c;border-radius:10px;background:#211f1c;margin-bottom:.8rem}
    .login button{width:100%}

    .bar{position:sticky;top:0;z-index:5;display:flex;gap:.5rem;padding:.6rem;background:#171717;border-bottom:1px solid #2e2a26}
    .bar button{flex:1}
    .msg{padding:.6rem .8rem;color:#a89886;font-size:.9rem;min-height:2.4rem}
    .msg.err{color:#ff9a8a}

    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:0 4px 9rem}
    .tile{position:relative;aspect-ratio:3/4;background:#211f1c;overflow:hidden;
      -webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
    .tile img{width:100%;height:100%;object-fit:cover;object-position:50% 65%;display:block;pointer-events:none}
    .tile.sel{outline:3px solid #d9c5ae;outline-offset:-3px}
    .tile.new::before{content:"новое";position:absolute;left:4px;top:4px;padding:1px 6px;border-radius:6px;
      background:#d9c5ae;color:#171717;font-size:.7rem;font-weight:600}
    .tile .num{position:absolute;right:4px;bottom:4px;padding:0 5px;border-radius:6px;background:#171717b3;font-size:.7rem}
    .ghost{opacity:.25}

    .acts{position:fixed;left:0;right:0;bottom:0;z-index:5;display:flex;gap:.5rem;
      padding:.6rem .6rem calc(.6rem + env(safe-area-inset-bottom));background:#171717;border-top:1px solid #2e2a26}
    .acts button{flex:1;padding:.7em .3em}

    .foot{position:fixed;right:.6rem;bottom:.4rem;font-size:.8rem}
    .foot button{background:none;color:#6f655a;padding:.4em}

    @media (min-width:700px){.grid{grid-template-columns:repeat(6,1fr)}}
  </style>
</head>
<body>
  <form class="login" id="login" hidden>
    <h1>Галерея работ</h1>
    <p>Вставьте токен GitHub. Он сохранится только на этом устройстве.</p>
    <input id="token" type="password" autocomplete="off" placeholder="github_pat_…" required>
    <button class="primary">Войти</button>
    <div class="msg" id="login-msg"></div>
  </form>

  <div id="app" hidden>
    <div class="bar">
      <button type="button" id="add">Добавить фото</button>
      <button type="button" id="publish" class="primary" disabled>Опубликовать</button>
    </div>
    <input id="files" type="file" accept="image/*" multiple hidden>
    <div class="msg" id="msg"></div>
    <div class="grid" id="grid"></div>

    <div class="acts" id="acts" hidden>
      <button type="button" id="to-start">В начало</button>
      <button type="button" id="to-end">В конец</button>
      <button type="button" id="del" class="danger">Удалить</button>
    </div>
    <div class="foot" id="foot">
      <button type="button" id="reset" hidden>Отменить изменения</button>
      <button type="button" id="logout">Выйти</button>
    </div>
  </div>

  <script src="/admin/sortable.min.js"></script>
  <script src="/assets/js/admin.js"></script>
</body>
</html>
