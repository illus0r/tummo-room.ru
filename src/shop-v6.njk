---
layout: base.njk
title: Керамика ручной работы — Tummo Room
---

{% set linkClass = "underline underline-offset-4 decoration-1 decoration-[#d9c5ae]/40 hover:decoration-[#d9c5ae] transition-colors" %}

{% set poolA = [
  { f: "portrait", a: "Оля спокойно смотрит в камеру, за спиной полки с керамикой" },
  { f: "wedge",    a: "Оля в фартуке мнёт глину на доске, тёплая гирлянда-боке" },
  { f: "throw",    a: "Мастер вытягивает высокую чашку на гончарном круге" },
  { f: "center",   a: "Руки центруют глину на гончарном круге, вид сбоку" },
  { f: "tea",      a: "Руки с гайванью пересыпают чайный лист в пиалу" },
  { f: "hand",     a: "Ладонь в глиняной пыли на плече, тёплый свет" }
] %}

{% set poolB = [
  { f: "doorway",  a: "Оля в запылённом фартуке стоит в дверном проёме, смотрит вниз" },
  { f: "window",   a: "Золотистый контровой профиль у окна, взгляд вверх" },
  { f: "stack",    a: "Руки держат вертикальную стопку из восьми глазурованных пиал" },
  { f: "sun",      a: "Лицо запрокинуто к солнцу, глаза закрыты" },
  { f: "cup",      a: "Синяя пиала с потёками глазури на подоконнике" },
  { f: "tumbler",  a: "Две руки держат светлый стакан-волну с потёками глазури" }
] %}

<style>
  .field {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-flow: row dense;
    gap: 2px;
    background: #0e0e0e;
    max-width: 1400px;
    margin: 0 auto;
  }
  .field > * { background: #171717; }

  .cluster { position: relative; overflow: hidden; background: #1e1e1e; }
  .cA { grid-column: 1 / 5; aspect-ratio: 2 / 3; }
  .cB { grid-column: 5 / 7; aspect-ratio: 1 / 3; }

  .t1 { grid-column: 1 / 5; }
  .t2 { grid-column: 5 / 7; }
  .t3 { grid-column: 1 / 7; }

  .img-wrap { position: absolute; inset: 0; will-change: transform; }
  .cA .img-wrap { animation: v6drift 17s ease-in-out infinite; }
  .cB .img-wrap { animation: v6drift 21s ease-in-out infinite; animation-delay: -7s; }
  @keyframes v6drift {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(0.9925); }
  }

  .img-wrap img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 34%;
    opacity: 0;
    transition: opacity 3s ease-in-out;
    will-change: opacity;
  }
  .cB .img-wrap img { object-position: center 42%; }
  .img-wrap img.is-on { opacity: 1; }

  /* Решётка швов поверх одного цельного фото */
  .seams {
    position: absolute; inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--sc, 4), 1fr);
    grid-template-rows: repeat(var(--sr, 6), 1fr);
    pointer-events: none;
    z-index: 2;
  }
  .seams .cell {
    position: relative;
    box-shadow: inset 0 0 0 1px rgba(8, 8, 8, 0.7), inset 0 0 14px rgba(0, 0, 0, 0.28);
    opacity: 0;
    transform: translate(0, 0) scale(1);
    transition: opacity 0.9s ease, transform 1.7s cubic-bezier(0.37, 0, 0.24, 1);
    transition-delay: calc(var(--d, 0) * 55ms);
  }
  .seams .cell::after {
    content: "";
    position: absolute; inset: 0;
    background: #000;
    opacity: 0;
    transition: opacity 1.4s ease;
    transition-delay: calc(var(--d, 0) * 55ms);
  }
  /* распад: швы проступают, ячейки чуть разъезжаются волной */
  .cluster.breathing .seams .cell {
    opacity: 1;
    transform: translate(calc(var(--dx, 0) * 6px), calc(var(--dy, 0) * 6px)) scale(0.992);
  }
  .cluster.breathing .seams .cell::after {
    opacity: calc(0.03 + 0.07 * var(--w, 0.5));
  }

  .tcell {
    padding: clamp(1.25rem, 3vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.4rem;
  }
  .tcell p {
    font-weight: 300;
    line-height: 1.62;
    color: #d9c5ae;
    max-width: 44ch;
  }
  .t1 p { font-size: clamp(1.2rem, 1.55vw, 1.7rem); }
  .t2 p { font-size: clamp(1.02rem, 1.15vw, 1.28rem); }
  .t3 p { font-size: clamp(1rem, 1.1vw, 1.22rem); max-width: 70ch; }
  .t3 .places { display: block; margin-top: 0.4rem; color: rgba(217, 197, 174, 0.9); }

  @media (max-width: 767px) {
    .field { grid-template-columns: 1fr; }
    .cA, .cB, .t1, .t2, .t3 { grid-column: 1 / -1; }
    .cA { aspect-ratio: 3 / 4; }
    .cB { aspect-ratio: 3 / 4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .img-wrap { animation: none !important; }
    .seams { display: none !important; }
    .img-wrap img { transition: none !important; }
  }
</style>

<main class="overflow-x-hidden">

  <header class="w-full px-4 md:px-10 pt-8 md:pt-12 pb-10 md:pb-16">
    <a href="/" class="inline-block">
      <img src="/assets/img/logo-horizontal.svg" alt="Tummo Room" class="h-14 w-auto">
    </a>
  </header>

  <section class="w-full px-4 md:px-10 pb-16 md:pb-24">
    <div class="field">

      <!-- Кластер A: 4×6 ячеек, портретная пропорция 2:3 -->
      <div class="cluster cA" data-cols="4" data-rows="6"
           data-period="20000" data-breathin="8000" data-breathhold="6000" data-start="4200">
        <div class="img-wrap">
          {% for p in poolA %}
          <img src="/assets/img/photo-{{ p.f }}.webp" alt="{{ p.a }}"
               {% if loop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {% endfor %}
        </div>
        <div class="seams"></div>
      </div>

      <!-- Кластер B: 2×6 ячеек, узкий вертикальный кадр -->
      <div class="cluster cB" data-cols="2" data-rows="6"
           data-period="24000" data-breathin="7000" data-breathhold="7000" data-start="11000">
        <div class="img-wrap">
          {% for p in poolB %}
          <img src="/assets/img/photo-{{ p.f }}.webp" alt="{{ p.a }}"
               {% if loop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {% endfor %}
        </div>
        <div class="seams"></div>
      </div>

      <!-- Текстовые ячейки — вне дышащих кластеров -->
      <div class="tcell t1">
        <p>Меня зовут Оля. Я делаю чайную керамику руками — в небольшой студии с видом на Волгу. Мне важно, чтобы посуда была тихой: чтобы не спорила с чаем, а помогала вернуться вниманием к себе и к этому моменту.</p>
      </div>

      <div class="tcell t2">
        <p>Вдохновляюсь природой. Прогулкой по лесу, где хочется остановиться и вдохнуть полной грудью. Корой дерева, игрой теней от листвы на земле, тем, как складываются естественные формы и цвета. Отсюда палитра и силуэты моих пиал.</p>
        <p>В керамике мне ближе всего спокойный цвет, естественные формы и небрежная асимметрия — как у природных фактур. Глина, глазури и жар печи — тоже стихии природы; я лишь помогаю им найти форму, где рукотворное и естественное в балансе. Это посуда для тех, кто умеет замедлиться и заметить красоту мира.</p>
      </div>

      <div class="tcell t3">
        <p>
          Купить керамику можно во ВКонтакте — <a href="https://vk.ru/tummo_room" class="{{ linkClass }}">vk.ru/tummo_room</a>. А ещё она есть в чайных:
          <span class="places">Волгоград — <a href="https://teaclouds.ru/" class="{{ linkClass }}">Чайные облака</a>, <a href="https://drakonisoroka.ru/" class="{{ linkClass }}">Дракон и сорока</a>, <a href="https://instagram.com/somely_me" class="{{ linkClass }}">Somely</a></span>
          <span class="places">Санкт-Петербург — <a href="https://vk.ru/tsikadatea" class="{{ linkClass }}">Цикада</a>, <a href="https://чяй.рф/" class="{{ linkClass }}">Чяй</a>, <a href="https://vk.ru/po_putea" class="{{ linkClass }}">По пути</a></span>
          <span class="places">Новосибирск — <a href="https://chajen.ru/" class="{{ linkClass }}">Ча жень</a>, <a href="https://vk.ru/2dragons_tea" class="{{ linkClass }}">Два дракона</a></span>
          <span class="places">Краснодар — <a href="https://koitea.taplink.ws/" class="{{ linkClass }}">Кои</a></span>
        </p>
        <p>Если вам близок мой стиль, я могу сделать керамику на заказ — для дома или для заведения. Напишите мне: <a href="https://t.me/Librocubic" class="{{ linkClass }}">@Librocubic</a>.</p>
      </div>

    </div>
  </section>

  <footer class="w-full px-4 md:px-10 pb-20 md:pb-28">
    <a href="/" class="text-xl md:text-2xl font-light {{ linkClass }}">← На главную</a>
  </footer>

</main>

<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var clusters = document.querySelectorAll('.cluster');

    Array.prototype.forEach.call(clusters, function (cl) {
      var cols = parseInt(cl.getAttribute('data-cols'), 10) || 4;
      var rows = parseInt(cl.getAttribute('data-rows'), 10) || 6;
      var seams = cl.querySelector('.seams');
      seams.style.setProperty('--sc', cols);
      seams.style.setProperty('--sr', rows);

      var cx = (cols - 1) / 2 || 1;
      var cy = (rows - 1) / 2 || 1;
      for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
          var cell = document.createElement('div');
          cell.className = 'cell';
          cell.style.setProperty('--dx', ((c - (cols - 1) / 2) / cx).toFixed(3));
          cell.style.setProperty('--dy', ((r - (rows - 1) / 2) / cy).toFixed(3));
          cell.style.setProperty('--d', (c + r));
          cell.style.setProperty('--w', (Math.sin((c + r) * 0.9) * 0.5 + 0.5).toFixed(3));
          seams.appendChild(cell);
        }
      }

      var imgs = Array.prototype.slice.call(cl.querySelectorAll('.img-wrap img'));
      if (imgs.length) imgs[0].classList.add('is-on');
      if (reduce || imgs.length < 2) return;

      var i = 0;
      var period = parseInt(cl.getAttribute('data-period'), 10) || 20000;
      var toBreath = parseInt(cl.getAttribute('data-breathin'), 10) || 8000;
      var hold = parseInt(cl.getAttribute('data-breathhold'), 10) || 6000;
      var start = parseInt(cl.getAttribute('data-start'), 10) || 0;

      function cycle() {
        // кроссфейд на следующий кадр в собранном состоянии
        imgs[i].classList.remove('is-on');
        i = (i + 1) % imgs.length;
        imgs[i].classList.add('is-on');
        // распад в решётку того же кадра, затем схлопывание
        setTimeout(function () { cl.classList.add('breathing'); }, toBreath);
        setTimeout(function () { cl.classList.remove('breathing'); }, toBreath + hold);
        setTimeout(cycle, period);
      }
      setTimeout(cycle, start);
    });
  })();
</script>
