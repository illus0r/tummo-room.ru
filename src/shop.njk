---
layout: base.njk
title: Керамика ручной работы — Tummo Room
---

<style>
  .v7-field{position:relative;width:100%;background:#171717;overflow:hidden}

  .v9-floor{position:absolute;left:0;right:0;overflow:hidden;z-index:0}
  .v9-floor .bg{position:absolute;left:0;width:100%;object-fit:cover;
    will-change:transform;filter:saturate(.9)}
  .v9-floor .dim{position:absolute;inset:0;background:#171717}

  .v7-text{position:absolute;z-index:2;color:#d9c5ae;font-weight:300;line-height:1.55;
    font-size:calc(clamp(13px,1.15vw,17px) * var(--tscale,1));box-sizing:border-box}
  .v7-text.hl{background:rgba(217,197,174,var(--tbg,.06));padding:1.05em 1.2em;border-radius:2px}
  .v7-text .buy{font-size:.92em}
  .v7-text .muted{opacity:.5}
  .v7-text a{text-decoration:underline;text-underline-offset:4px;
    text-decoration-thickness:1px;text-decoration-color:rgba(217,197,174,.4)}
  .v7-text a:hover{text-decoration-color:#d9c5ae}
  .v7-fixed{position:absolute;z-index:3;color:#d9c5ae;font-weight:300}

  .v7-photo{position:absolute;z-index:1;object-fit:cover;opacity:0;
    transition:opacity var(--fade,1150ms) ease-in-out;will-change:opacity}
  .v7-photo.on{opacity:1}

  .v7-dbg{position:absolute;inset:0;z-index:4;pointer-events:none;opacity:.16;
    background-image:
      repeating-linear-gradient(to right,#d9c5ae 0 1px,transparent 1px var(--cw,80px)),
      repeating-linear-gradient(to bottom,#d9c5ae 0 1px,transparent 1px var(--ch,80px))}

  .v7-toggle{position:fixed;top:12px;right:12px;z-index:51;
    background:rgba(10,10,10,.82);color:#d9c5ae;border:0;border-radius:8px;
    padding:6px 10px;font:400 13px/1 system-ui,sans-serif;cursor:pointer}
  .v7-panel{position:fixed;top:50px;right:12px;z-index:50;width:256px;
    max-width:calc(100vw - 24px);max-height:calc(100vh - 64px);overflow:auto;
    background:rgba(10,10,10,.9);backdrop-filter:blur(8px);color:#d9c5ae;
    font:400 12px/1.35 system-ui,sans-serif;border-radius:8px;padding:10px 12px 12px}
  .v7-panel[hidden]{display:none}
  .v7-head{margin:12px 0 4px;font-weight:700;letter-spacing:.14em;font-size:10px;opacity:.55}
  .v7-head:first-child{margin-top:0}
  .v7-row{margin-top:8px}
  .v7-row .lbl{display:flex;justify-content:space-between;gap:8px;margin-bottom:2px}
  .v7-row .lbl span{border-bottom:1px dotted rgba(217,197,174,.35);cursor:help}
  .v7-row .lbl b{font-weight:600;font-variant-numeric:tabular-nums;opacity:.85}
  .v7-panel input[type=range]{width:100%;accent-color:#d9c5ae;margin:0}
  .v7-panel select{width:100%;background:#1c1c1c;color:#d9c5ae;border:1px solid #3a3a3a;
    border-radius:4px;padding:3px 4px;font:inherit}
  .v7-check{display:flex;align-items:center;gap:6px;margin-top:9px;cursor:help}
  .v7-panel button{margin-top:12px;width:100%;background:rgba(217,197,174,.12);
    color:#d9c5ae;border:0;border-radius:6px;padding:6px;font:inherit;cursor:pointer}
  .v7-panel button:hover{background:rgba(217,197,174,.2)}

  @media (max-width:767px){
    .v7-field{height:auto!important;overflow:visible;padding:1.2rem 0 2.5rem}
    .v9-floor{display:none!important}
    .v7-text{position:relative!important;inset:auto!important;width:auto!important;
      margin:1.7rem auto 0!important;max-width:34rem;padding:0 1.35rem!important;
      background:none!important;font-size:clamp(14px,4vw,17px)!important}
    .v7-fixed{position:static!important;inset:auto!important;display:block;margin:.5rem 1.35rem}
    .v7-photo,.v7-dbg,.v7-toggle,.v7-panel{display:none!important}
  }
  @media (prefers-reduced-motion:reduce){.v7-photo{transition:opacity 200ms linear}}
</style>

<main class="v7-field" id="v7field">
  <a href="/" class="v7-fixed" data-fixed style="left:2.1rem;top:1.5rem">
    <img src="/assets/img/logo-horizontal.svg" alt="Туммо" style="height:2.6rem;width:auto;display:block">
  </a>

  <div class="v7-text" data-txt>
    Меня зовут Оля. Я делаю чайную керамику руками — в небольшой студии с видом на Волгу.
    Мне важно, чтобы посуда была тихой: чтобы не спорила с чаем, а помогала вернуться
    вниманием к себе и к этому моменту.
  </div>

  <div class="v7-text" data-txt>
    Вдохновляюсь природой. Прогулкой по лесу, где хочется остановиться и вдохнуть полной
    грудью. Корой дерева, игрой теней от листвы на земле, тем, как складываются естественные
    формы и цвета. Отсюда палитра и силуэты моих пиал.
  </div>

  <div class="v7-text" data-txt>
    В керамике мне ближе всего спокойный цвет, естественные формы и небрежная асимметрия —
    как у природных фактур. Глина, глазури и жар печи — тоже стихии природы; я лишь помогаю
    им найти форму, где рукотворное и естественное в балансе. Это посуда для тех, кто умеет
    замедлиться и заметить красоту мира.
  </div>

  <div class="v7-text buy" data-txt>
    Купить керамику можно во ВКонтакте —
    <a href="https://vk.ru/tummo_room">vk.ru/tummo_room</a>. А ещё она есть в чайных:
    <div style="margin-top:.6em">
      <div><span class="muted">Волгоград — </span><a href="https://teaclouds.ru/">Чайные облака</a>, <a href="https://drakonisoroka.ru/">Дракон и сорока</a>, <a href="https://instagram.com/somely_me">Somely</a></div>
      <div><span class="muted">Санкт-Петербург — </span><a href="https://vk.ru/tsikadatea">Цикада</a>, <a href="https://чяй.рф/">Чяй</a>, <a href="https://vk.ru/po_putea">По пути</a></div>
      <div><span class="muted">Новосибирск — </span><a href="https://chajen.ru/">Ча жень</a>, <a href="https://vk.ru/2dragons_tea">Два дракона</a></div>
      <div><span class="muted">Краснодар — </span><a href="https://koitea.taplink.ws/">Кои</a></div>
    </div>
  </div>

  <div class="v7-text" data-txt>
    Если вам близок мой стиль, я могу сделать керамику на заказ — для дома или для заведения.
    Напишите мне: <a href="https://t.me/Librocubic">@Librocubic</a>.
  </div>

  <a href="/" class="v7-fixed" data-fixed id="v7back"
     style="left:2.1rem;font-size:.82rem;opacity:.55">← На главную</a>

  <div class="v7-dbg" id="v7dbg" hidden></div>
</main>

<button class="v7-toggle" id="v7toggle" aria-label="Параметры">⚙</button>
<form class="v7-panel" id="v7panel" hidden></form>

{% raw %}
<script>
(function () {
  var field = document.getElementById('v7field');
  var dbg = document.getElementById('v7dbg');
  var backlink = document.getElementById('v7back');
  var panel = document.getElementById('v7panel');
  var toggle = document.getElementById('v7toggle');

  var POOL = ['photo-stack','photo-tumbler','photo-cup','photo-table','photo-tea','photo-vase',
    'photo-knead','photo-wedge','photo-throw','photo-center','photo-portrait','photo-doorway',
    'photo-sun','photo-window','photo-hand'];
  var ASPECT = {}; POOL.forEach(function (n) { ASPECT[n] = 1400 / 2100; });
  // фоны этажей
  var FLOOR_BGS = ['shop-ceramics','photo-vase','shop-tea','photo-table','nature2'];

  var DEF = {
    // фото
    cols:10, tickMs:650, holdMs:4650, fadeMs:1150, maxPhotos:11,
    tolPct:45, minU:3, maxU:6, attempts:13, iters:8,
    // текст (в клетках сетки)
    txtCols:5, txtGapRows:3, txtInsetCols:2, txtStartRows:4,
    txtScale:143, txtAlign:0, txtBgOn:true, txtBgOpacity:0,
    // этажи
    parallax:45, floorDim:55,
    paused:false, showGrid:false
  };
  var PHOTO_SPEC = [
    ['cols',    'колонок',      6, 28, 1, 'На сколько столбцов делится ширина страницы. Задаёт размер клетки — к ней привязаны и фотографии, и текстовые блоки, и границы этажей.'],
    ['tickMs',  'тик, мс',    120,3000,10, 'Как часто система пытается показать новую фотографию. Меньше значение — вспышки появляются чаще.'],
    ['holdMs',  'показ, мс',  150,6000,50, 'Сколько времени фотография держится на экране в полной видимости, прежде чем начать растворяться.'],
    ['fadeMs',  'фейд, мс',    40,2600,10, 'Длительность плавного проявления и растворения каждой фотографии.'],
    ['maxPhotos','фото разом',  1, 18, 1, 'Максимум фотографий, одновременно видимых на экране.'],
    ['tolPct',  'допуск, %',    2, 60, 1, 'Насколько пропорции прямоугольника-места могут отличаться от пропорций самого снимка. Больше — допускается более заметная обрезка кадра.'],
    ['minU',    'мин. сторона', 1, 14, 1, 'Наименьшая сторона прямоугольника под фото, в клетках. Ограничивает снизу размер вспышек.'],
    ['maxU',    'макс. сторона',2, 22, 1, 'Наибольшая сторона прямоугольника под фото, в клетках. Поднимите, чтобы фотографии могли быть крупнее.'],
    ['attempts','перебор/тик',  6,120, 1, 'Сколько случайных прямоугольников система проверяет за один тик, подбирая свободное подходящее место.'],
    ['iters',   'итераций',     1, 40, 1, 'Из скольких подходящих вариантов выбирается лучший — по площади и точности пропорций. Больше — крупнее и аккуратнее кадрирование.']
  ];
  var TEXT_SPEC = [
    ['txtCols',     'ширина, клеток',        1, 14, 1, 'Ширина каждого текстового блока в клетках сетки.'],
    ['txtGapRows',  'между блоками, клеток', 0, 24, 1, 'Вертикальный промежуток между соседними блоками текста, в клетках.'],
    ['txtInsetCols','отступ от края, клеток',0, 16, 1, 'На сколько клеток блок отступает от левого или правого края страницы.'],
    ['txtStartRows','первый сверху, клеток', 0, 28, 1, 'Отступ первого блока от верхнего края страницы, в клетках.'],
    ['txtScale',    'кегль, %',             75,170, 1, 'Размер шрифта в текстовых блоках относительно базового.'],
    ['txtBgOpacity','фон подложки, %',       0, 40, 1, 'Непрозрачность светлой плашки под текстом. 0 — плашки не видно, даже если она включена.']
  ];
  var FLOOR_SPEC = [
    ['parallax', 'параллакс фона, %', 0, 100, 1, 'Насколько фон этажа отстаёт от страницы при прокрутке. 0 — фон едет вместе со всем, 100 — заметно отстаёт, создавая глубину.'],
    ['floorDim', 'затемнение фона, %', 0, 92, 1, 'Насколько притушен фоновый снимок этажа. Больше — темнее фон, лучше читаются текст и вспышки поверх него.']
  ];

  var cfg = load();
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var isMobile = function () { return window.matchMedia('(max-width:767px)').matches; };
  var textEls = [].slice.call(field.querySelectorAll('[data-txt]'));
  var textRects = [];
  var floorBands = [];
  var floors = [];
  var gridRows = 1;

  function layoutText() {
    if (isMobile()) {
      textEls.forEach(function (el) {
        el.style.left = el.style.right = el.style.top = el.style.width = '';
        el.classList.remove('hl');
      });
      field.style.height = '';
      textRects = []; floorBands = [];
      return;
    }
    var W = field.clientWidth;
    var cell = W / cfg.cols;
    var cols = cfg.cols;
    var tcols = Math.max(1, Math.min(cfg.txtCols, cols - 1));
    var inset = Math.max(0, Math.min(cfg.txtInsetCols, cols - tcols));
    field.style.setProperty('--tscale', cfg.txtScale / 100);
    field.style.setProperty('--tbg', cfg.txtBgOpacity / 100);

    var rowCursor = cfg.txtStartRows;
    textRects = [];
    var blockRows = [];
    textEls.forEach(function (el, i) {
      el.classList.toggle('hl', !!cfg.txtBgOn);
      el.style.width = (tcols * cell) + 'px';
      var toLeft = (cfg.txtAlign === 1) || (cfg.txtAlign === 0 && i % 2 === 0);
      var colX = toLeft ? inset : (cols - inset - tcols);
      if (colX < 0) colX = 0;
      el.style.left = (colX * cell) + 'px';
      el.style.right = 'auto';
      el.style.top = (rowCursor * cell) + 'px';
      var hRows = Math.max(1, Math.ceil(el.offsetHeight / cell));
      textRects.push({
        l: colX * cell, t: rowCursor * cell,
        r: (colX + tcols) * cell, b: (rowCursor + hRows) * cell
      });
      blockRows.push({ top: rowCursor, bot: rowCursor + hRows });
      rowCursor += hRows + cfg.txtGapRows;
    });
    rowCursor -= cfg.txtGapRows;
    var tailRows = Math.max(2, cfg.txtGapRows);
    var fieldH = Math.max((rowCursor + tailRows) * cell, window.innerHeight);
    field.style.height = fieldH + 'px';
    backlink.style.top = (rowCursor * cell + cell) + 'px';
    gridRows = Math.max(1, Math.round(fieldH / cell));

    var lg = field.querySelector('[data-fixed]');
    var lr = lg.getBoundingClientRect(), fr = field.getBoundingClientRect();
    textRects.push({ l: lr.left - fr.left - 8, t: 0, r: lr.right - fr.left + 8, b: lr.bottom - fr.top + 12 });
    var brk = backlink.getBoundingClientRect();
    textRects.push({ l: 0, t: brk.top - fr.top - 8, r: brk.right - fr.left + 12, b: fieldH });

    // границы этажей — по линиям сетки, между абзацами
    floorBands = [];
    var starts = [0];
    for (var i = 1; i < blockRows.length; i++) {
      starts.push(Math.round((blockRows[i - 1].bot + blockRows[i].top) / 2));
    }
    starts.push(gridRows);
    for (i = 0; i < blockRows.length; i++) floorBands.push({ s: starts[i], e: starts[i + 1] });
  }

  function buildFloors() {
    [].slice.call(field.querySelectorAll('.v9-floor')).forEach(function (n) { n.remove(); });
    floors = [];
    if (isMobile() || !floorBands.length) return;
    var cell = field.clientWidth / cfg.cols;
    var par = cfg.parallax / 100 * 150;
    floorBands.forEach(function (b, i) {
      var el = document.createElement('div');
      el.className = 'v9-floor';
      el.style.top = (b.s * cell) + 'px';
      el.style.height = ((b.e - b.s) * cell) + 'px';
      var bg = new Image();
      bg.className = 'bg'; bg.alt = '';
      bg.style.top = (-par) + 'px';
      bg.style.height = 'calc(100% + ' + (2 * par) + 'px)';
      bg.src = '/assets/img/' + FLOOR_BGS[i % FLOOR_BGS.length] + '.webp';
      var dim = document.createElement('div');
      dim.className = 'dim';
      dim.style.opacity = cfg.floorDim / 100;
      el.appendChild(bg); el.appendChild(dim);
      field.insertBefore(el, field.firstChild);
      floors.push({ el: el, bg: bg, par: par });
    });
    onScroll();
  }

  function onScroll() {
    if (!floors.length) return;
    var vh = window.innerHeight;
    for (var i = 0; i < floors.length; i++) {
      var f = floors[i];
      var r = f.el.getBoundingClientRect();
      var p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2);
      if (p > 1) p = 1; if (p < -1) p = -1;
      f.bg.style.transform = 'translateY(' + (-p * f.par).toFixed(1) + 'px)';
    }
  }

  var active = [];
  function hit(a, b, pad) {
    pad = pad || 0;
    return !(a.r + pad <= b.l || a.l - pad >= b.r || a.b + pad <= b.t || a.t - pad >= b.b);
  }
  function ri(lo, hi) { if (hi < lo) { var s = lo; lo = hi; hi = s; } return lo + Math.floor(Math.random() * (hi - lo + 1)); }

  function tryPlace() {
    if (active.length >= cfg.maxPhotos) return;
    var W = field.clientWidth, H = field.clientHeight;
    var cell = W / cfg.cols;
    var rows = Math.max(1, Math.floor(H / cell));
    var tol = cfg.tolPct / 100;
    var vTop = window.scrollY - field.offsetTop;
    var b0 = Math.max(0, vTop - 0.25 * window.innerHeight);
    var b1 = Math.min(H, vTop + 1.25 * window.innerHeight);

    var best = null, bestF = -1, found = 0;
    for (var k = 0; k < cfg.attempts && found < cfg.iters; k++) {
      var name = POOL[(Math.random() * POOL.length) | 0];
      if (active.some(function (p) { return p.name === name; })) continue;
      var pa = ASPECT[name];
      var hU = ri(cfg.minU, cfg.maxU);
      var wU = Math.round(pa * hU + (Math.random() * 1.4 - 0.7));
      if (wU < 1) wU = 1;
      if (wU > cfg.cols || hU > rows) continue;
      var aspect = wU / hU;
      var aspErr = Math.abs(aspect - pa) / pa;
      if (aspErr > tol) continue;
      var xU = ri(0, cfg.cols - wU);
      var yLo = b0, yHi = b1 - hU * cell;
      if (yHi <= yLo) { yLo = 0; yHi = H - hU * cell; }
      if (yHi < 0) continue;
      var yU = Math.round((yLo + Math.random() * (yHi - yLo)) / cell);
      if (yU < 0) yU = 0;
      if (yU > rows - hU) yU = rows - hU;
      var rect = { l: xU * cell, t: yU * cell, r: (xU + wU) * cell, b: (yU + hU) * cell };
      var bad = false, i;
      for (i = 0; i < textRects.length; i++) if (hit(rect, textRects[i], 0)) { bad = true; break; }
      if (bad) continue;
      for (i = 0; i < active.length; i++) if (hit(rect, active[i], 2)) { bad = true; break; }
      if (bad) continue;
      found++;
      var area = wU * hU;
      var norm = tol > 0 ? Math.min(1, aspErr / tol) : 0;
      var f = area * (1 - 0.6 * norm);
      if (f > bestF) { bestF = f; best = { name: name, rect: rect }; }
    }
    if (best) place(best.name, best.rect);
  }

  function place(name, rect) {
    var img = new Image();
    img.className = 'v7-photo';
    img.alt = '';
    img.style.left = rect.l + 'px';
    img.style.top = rect.t + 'px';
    img.style.width = (rect.r - rect.l) + 'px';
    img.style.height = (rect.b - rect.t) + 'px';
    img.style.setProperty('--fade', cfg.fadeMs + 'ms');
    img.onload = function () {
      if (img.naturalWidth && img.naturalHeight) ASPECT[name] = img.naturalWidth / img.naturalHeight;
    };
    img.src = '/assets/img/' + name + '.webp';
    field.appendChild(img);
    var e = { el: img, name: name, l: rect.l, t: rect.t, r: rect.r, b: rect.b };
    active.push(e);
    // eslint-disable-next-line no-unused-expressions
    img.offsetWidth;
    setTimeout(function () { img.classList.add('on'); }, 20);
    if (reduce) return;
    e.t1 = setTimeout(function () {
      img.classList.remove('on');
      e.t2 = setTimeout(function () {
        img.remove();
        var i = active.indexOf(e);
        if (i >= 0) active.splice(i, 1);
      }, cfg.fadeMs + 60);
    }, cfg.holdMs + cfg.fadeMs);
  }

  var timer = null;
  function loop() {
    if (!cfg.paused && !isMobile() && !document.hidden) tryPlace();
    timer = setTimeout(loop, cfg.tickMs);
  }

  function drawGrid() {
    dbg.hidden = !cfg.showGrid || isMobile();
    if (dbg.hidden) return;
    var cw = field.clientWidth / cfg.cols;
    dbg.style.setProperty('--cw', cw + 'px');
    dbg.style.setProperty('--ch', cw + 'px');
  }

  function apply() { layoutText(); buildFloors(); drawGrid(); }

  // ---- панель ----
  function head(txt) { var d = document.createElement('div'); d.className = 'v7-head'; d.textContent = txt; return d; }
  function row(s) {
    var key = s[0], label = s[1], min = s[2], max = s[3], step = s[4], desc = s[5];
    var wrap = document.createElement('div');
    wrap.className = 'v7-row';
    var lbl = document.createElement('div'); lbl.className = 'lbl';
    var n = document.createElement('span'); n.textContent = label; if (desc) n.title = desc;
    var v = document.createElement('b'); v.textContent = cfg[key];
    lbl.appendChild(n); lbl.appendChild(v);
    var inp = document.createElement('input');
    inp.type = 'range'; inp.min = min; inp.max = max; inp.step = step; inp.value = cfg[key];
    if (desc) inp.title = desc;
    inp.addEventListener('input', function () {
      cfg[key] = parseFloat(inp.value); v.textContent = cfg[key]; save(); apply();
    });
    wrap.appendChild(lbl); wrap.appendChild(inp);
    return wrap;
  }
  function sel(key, label, opts, desc) {
    var wrap = document.createElement('div'); wrap.className = 'v7-row';
    var lbl = document.createElement('div'); lbl.className = 'lbl';
    var n = document.createElement('span'); n.textContent = label; if (desc) n.title = desc;
    lbl.appendChild(n); wrap.appendChild(lbl);
    var se = document.createElement('select'); if (desc) se.title = desc;
    opts.forEach(function (o, i) { var op = document.createElement('option'); op.value = i; op.textContent = o; se.appendChild(op); });
    se.value = cfg[key];
    se.addEventListener('change', function () { cfg[key] = parseInt(se.value, 10); save(); apply(); });
    wrap.appendChild(se); return wrap;
  }
  function check(key, label, desc) {
    var wrap = document.createElement('label'); wrap.className = 'v7-check'; if (desc) wrap.title = desc;
    var inp = document.createElement('input'); inp.type = 'checkbox'; inp.checked = !!cfg[key];
    inp.addEventListener('change', function () { cfg[key] = inp.checked; save(); apply(); });
    var s = document.createElement('span'); s.textContent = label;
    wrap.appendChild(inp); wrap.appendChild(s); return wrap;
  }
  function buildPanel() {
    panel.innerHTML = '';
    panel.appendChild(head('ФОТО'));
    PHOTO_SPEC.forEach(function (s) { panel.appendChild(row(s)); });
    panel.appendChild(head('ТЕКСТ'));
    TEXT_SPEC.forEach(function (s) { panel.appendChild(row(s)); });
    panel.appendChild(sel('txtAlign', 'выравнивание', ['чередовать', 'слева', 'справа'],
      'С какой стороны стоят блоки: строго слева, строго справа или попеременно.'));
    panel.appendChild(check('txtBgOn', 'подложка под текстом',
      'Включить светлую плашку за текстом. Её прозрачность задаётся ползунком «фон подложки».'));
    panel.appendChild(head('ЭТАЖИ'));
    FLOOR_SPEC.forEach(function (s) { panel.appendChild(row(s)); });
    panel.appendChild(head('ОБЩЕЕ'));
    panel.appendChild(check('paused', 'пауза', 'Остановить появление новых фотографий-вспышек.'));
    panel.appendChild(check('showGrid', 'показать сетку', 'Показать служебную сетку из клеток — удобно при настройке раскладки.'));
    var reset = document.createElement('button');
    reset.type = 'button'; reset.textContent = 'сбросить';
    reset.addEventListener('click', function () { cfg = Object.assign({}, DEF); save(); buildPanel(); apply(); });
    panel.appendChild(reset);
  }
  toggle.addEventListener('click', function () {
    panel.hidden = !panel.hidden;
    toggle.textContent = panel.hidden ? '⚙' : '✕';
  });

  function load() {
    var c = Object.assign({}, DEF);
    try {
      var raw = localStorage.getItem('tummo-shop-cfg');
      if (raw) { var o = JSON.parse(raw); for (var k in DEF) if (k in o) c[k] = o[k]; }
    } catch (e) {}
    try {
      var q = new URLSearchParams(location.search);
      for (var key in DEF) {
        if (!q.has(key)) continue;
        var val = q.get(key);
        c[key] = (typeof DEF[key] === 'boolean') ? (val === '1' || val === 'true') : parseFloat(val);
      }
    } catch (e2) {}
    return c;
  }
  function save() { try { localStorage.setItem('tummo-shop-cfg', JSON.stringify(cfg)); } catch (e) {} }

  var rt;
  window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(apply, 130); });
  window.addEventListener('scroll', function () {
    if (window.rq) return;
    window.rq = requestAnimationFrame(function () { window.rq = 0; onScroll(); });
  }, { passive: true });
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden && !reduce && timer == null) loop();
  });

  buildPanel();
  apply();
  if (reduce) { for (var i = 0; i < 5; i++) tryPlace(); }
  else loop();
})();
</script>
