  { f: "sun",      a: "Лицо запрокинуто к солнцу, глаза закрыты" },
  { f: "portrait", a: "Оля смотрит в камеру, за спиной полки с керамикой" },
  { f: "doorway",  a: "Оля в запылённом фартуке стоит в дверном проёме" },
  { f: "throw",    a: "Мастер вытягивает высокую чашку на гончарном круге" },
