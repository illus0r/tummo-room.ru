layout: base.njk
title: Керамика ручной работы — Tummo Room
---

{% set linkClass = "underline underline-offset-4 decoration-1 decoration-[#d9c5ae]/40 hover:decoration-[#d9c5ae] transition-colors" %}

<style>
  .tect-wrap { max-width: 1600px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 768px) { .tect-wrap { padding: 0 40px; } }

  /* Тектоника: крупный юнит, разрежённая сетка, много пустого тёмного */
  .field {
    position: relative;
    width: 100%;
    --cols: 3;
    --rh: clamp(66px, 22.5vw, 116px);
    --seam: #262626;      /* шов чуть светлее фона */
  }
  @media (min-width: 768px) {
    .field { --cols: 6; --rh: clamp(88px, 14.5vw, 188px); }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    grid-auto-rows: var(--rh);
    gap: 2px;                       /* видимый шов между ячейками */
  }

  /* базовый слой — сама плитка прямоугольников */
  .base { background: var(--seam); }
  .base > i { display: block; background: #171717; }

  /* слой кластеров поверх плитки, точно по той же сетке */
  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: transparent;
  }

  /* фото-кластер: одна картинка на весь прямоугольник, кроссфейд */
  .pc {
    position: relative;
    z-index: 1;
    overflow: hidden;
    background: #171717;
    opacity: 0;
    transition: opacity var(--fade, 2.6s) ease-in-out;
    will-change: opacity;
  }
  .pc.on { opacity: 1; }         /* при сборке кластера швы под ним «зарастают» */
  .pc img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;          /* голову и вазу не режем */
    display: block;
  }

  /* текстовый кластер — сплошная тёмная панель, текст всегда читаем */
  .tc {
    position: relative;
    z-index: 2;
    pointer-events: auto;
    background: #171717;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(14px, 2.2vw, 34px);
    font-weight: 300;
    line-height: 1.55;
    color: #d9c5ae;
  }
  .tc p { font-size: clamp(0.95rem, 1.15vw, 1.28rem); max-width: 44ch; }
  .tc .lines { font-size: clamp(0.9rem, 1.02vw, 1.12rem); max-width: 46ch; }
  .tc .lines .lead { margin-bottom: 0.5em; }
  .tc .lines span { display: block; margin-top: 0.5em; }

  @media (prefers-reduced-motion: reduce) {
    .pc { transition: none !important; }
  }
</style>

<main class="overflow-x-hidden">

  <header class="tect-wrap pt-8 md:pt-12 pb-10 md:pb-20">
    <a href="/" class="inline-block">
      <img src="/assets/img/logo-horizontal.svg" alt="Tummo Room" class="h-14 w-auto">
    </a>
  </header>

  <div class="tect-wrap">
    <div class="field" id="field">
      <div class="grid base" id="base" aria-hidden="true"></div>
      <div class="grid layer" id="layer">

        <div class="tc" data-key="1">
          <p>Меня зовут Оля. Я делаю чайную керамику руками — в небольшой студии с видом на Волгу. Мне важно, чтобы посуда была тихой: чтобы не спорила с чаем, а помогала вернуться вниманием к себе и к этому моменту.</p>
        </div>

        <div class="tc" data-key="2">
          <p>Вдохновляюсь природой. Прогулкой по лесу, где хочется остановиться и вдохнуть полной грудью. Корой дерева, игрой теней от листвы на земле, тем, как складываются естественные формы и цвета. Отсюда палитра и силуэты моих пиал.</p>
        </div>

        <div class="tc" data-key="3">
          <p>В керамике мне ближе всего спокойный цвет, естественные формы и небрежная асимметрия — как у природных фактур. Глина, глазури и жар печи — тоже стихии природы; я лишь помогаю им найти форму, где рукотворное и естественное в балансе. Это посуда для тех, кто умеет замедлиться и заметить красоту мира.</p>
        </div>

        <div class="tc" data-key="4">
          <div class="lines">
            <p class="lead">Купить керамику можно во ВКонтакте — <a href="https://vk.ru/tummo_room" class="{{ linkClass }}">vk.ru/tummo_room</a>. А ещё она есть в чайных:</p>
            <span>Волгоград — <a href="https://teaclouds.ru/" class="{{ linkClass }}">Чайные облака</a>, <a href="https://drakonisoroka.ru/" class="{{ linkClass }}">Дракон и сорока</a>, <a href="https://instagram.com/somely_me" class="{{ linkClass }}">Somely</a></span>
            <span>Санкт-Петербург — <a href="https://vk.ru/tsikadatea" class="{{ linkClass }}">Цикада</a>, <a href="https://чяй.рф/" class="{{ linkClass }}">Чяй</a>, <a href="https://vk.ru/po_putea" class="{{ linkClass }}">По пути</a></span>
            <span>Новосибирск — <a href="https://chajen.ru/" class="{{ linkClass }}">Ча жень</a>, <a href="https://vk.ru/2dragons_tea" class="{{ linkClass }}">Два дракона</a></span>
            <span>Краснодар — <a href="https://koitea.taplink.ws/" class="{{ linkClass }}">Кои</a></span>
          </div>
        </div>

        <div class="tc" data-key="5">
          <p>Если вам близок мой стиль, я могу сделать керамику на заказ — для дома или для заведения. Напишите мне: <a href="https://t.me/Librocubic" class="{{ linkClass }}">@Librocubic</a>.</p>
        </div>

      </div>
    </div>
  </div>

  <footer class="tect-wrap pt-14 md:pt-24 pb-16 md:pb-28">
    <a href="/" class="text-xl md:text-2xl font-light {{ linkClass }}">← На главную</a>
  </footer>

</main>

<script>
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var base = document.getElementById('base');
  var layer = document.getElementById('layer');

  var texts = {};
  Array.prototype.forEach.call(layer.querySelectorAll('.tc'), function (el) {
    texts[el.getAttribute('data-key')] = el;
  });

  var PHOTOS = [
    ['stack',    'Руки держат вертикальную стопку из восьми глазурованных пиал'],
    ['tumbler',  'Две руки держат светлый стакан-волну с потёками глазури'],
    ['cup',      'Синяя пиала с потёками глазури на подоконнике'],
    ['table',    'Готовые пиалы на столе, рука тянется за одной'],
    ['tea',      'Руки с гайванью пересыпают чайный лист в пиалу'],
    ['vase',     'Сухие полевые травы в рукотворной вазе против света'],
    ['knead',    'Две руки приминают шарик глины на гончарном круге'],
    ['wedge',    'Мастер в фартуке мнёт глину на доске, гирлянда-боке позади'],
    ['throw',    'Мастер вытягивает высокую чашку на гончарном круге'],
    ['center',   'Руки центруют глину на гончарном круге, вид сбоку'],
    ['portrait', 'Оля смотрит в камеру, за спиной полки с керамикой'],
    ['doorway',  'Оля в запылённом фартуке стоит в дверном проёме'],
    ['sun',      'Лицо запрокинуто к солнцу, глаза закрыты, тёмный фон'],
    ['window',   'Золотистый контровой профиль у окна'],
    ['hand',     'Ладонь в глиняной пыли на плече, тёплый свет']
  ];
  var ALT = {};
  PHOTOS.forEach(function (p) { ALT[p[0]] = p[1]; });

  // Desktop: 6 колонок x 14 рядов, крупный юнит
  var DESK = {
    cols: 6, rows: 14, low: 3, high: 4,
    texts: {
      '1': { c: 1, r: 1,  w: 3, h: 2 },
      '2': { c: 4, r: 4,  w: 3, h: 2 },
      '3': { c: 1, r: 7,  w: 3, h: 3 },
      '4': { c: 1, r: 12, w: 4, h: 3 },
      '5': { c: 4, r: 10, w: 3, h: 2 }
    },
    slots: [
      { c: 4, r: 1,  w: 2, h: 3 }, { c: 5, r: 1,  w: 2, h: 3 }, { c: 4, r: 1, w: 3, h: 2 },
      { c: 1, r: 3,  w: 2, h: 3 }, { c: 2, r: 3,  w: 2, h: 3 }, { c: 1, r: 4, w: 3, h: 2 },
      { c: 1, r: 3,  w: 3, h: 3 },
      { c: 4, r: 6,  w: 2, h: 4 }, { c: 5, r: 6,  w: 2, h: 4 }, { c: 4, r: 7, w: 3, h: 3 },
      { c: 4, r: 6,  w: 3, h: 4 },
      { c: 1, r: 10, w: 2, h: 2 }, { c: 2, r: 10, w: 2, h: 2 },
      { c: 5, r: 12, w: 2, h: 3 }
    ],
    initial: [1, 3, 7, 13]
  };

  // Mobile: 3 колонки x 30 рядов, кластеры мельче, тот же медленный пейс
  var MOB = {
    cols: 3, rows: 30, low: 2, high: 3,
    texts: {
      '1': { c: 1, r: 1,  w: 3, h: 3 },
      '2': { c: 1, r: 7,  w: 3, h: 3 },
      '3': { c: 1, r: 13, w: 3, h: 4 },
      '4': { c: 1, r: 20, w: 3, h: 5 },
      '5': { c: 1, r: 27, w: 3, h: 3 }
    },
    slots: [
      { c: 1, r: 4,  w: 2, h: 3 }, { c: 2, r: 4,  w: 2, h: 3 }, { c: 1, r: 4,  w: 3, h: 3 },
      { c: 1, r: 10, w: 2, h: 3 }, { c: 2, r: 10, w: 2, h: 3 }, { c: 1, r: 10, w: 3, h: 3 },
      { c: 1, r: 17, w: 2, h: 3 }, { c: 2, r: 17, w: 2, h: 3 }, { c: 1, r: 17, w: 3, h: 3 },
      { c: 1, r: 25, w: 2, h: 2 }, { c: 2, r: 25, w: 2, h: 2 }
    ],
    initial: [1, 3, 8]
  };

  var cfg = DESK;
  var active = [];
  var openSlots = [];
  var bag = [];
  var eagerCount = 0;
  var timer = null;
  var resizeTimer = null;
  var isMobile = false;

  function rnd(a, b) { return a + Math.random() * (b - a); }
  function pick(a) { return a[Math.floor(Math.random() * a.length)]; }
  function shuffle(a) {
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = a[i]; a[i] = a[j]; a[j] = t;
    }
    return a;
  }
  function overlap(a, b) {
    return a.c < b.c + b.w && b.c < a.c + a.w && a.r < b.r + b.h && b.r < a.r + a.h;
  }
  function textFree(slot) {
    for (var k in cfg.texts) {
      if (cfg.texts.hasOwnProperty(k) && overlap(slot, cfg.texts[k])) return false;
    }
    return true;
  }
  function slotBusy(slot) {
    for (var i = 0; i < active.length; i++) {
      if (overlap(slot, active[i].slot)) return true;
    }
    return false;
  }
  function nextKey(avoid) {
    if (!bag.length) bag = shuffle(PHOTOS.map(function (p) { return p[0]; }));
    for (var i = 0; i < bag.length; i++) {
      if (avoid.indexOf(bag[i]) < 0) return bag.splice(i, 1)[0];
    }
    return bag.pop();
  }

  function buildBase() {
    base.innerHTML = '';
    var n = cfg.cols * cfg.rows;
    var frag = document.createDocumentFragment();
    for (var i = 0; i < n; i++) frag.appendChild(document.createElement('i'));
    base.appendChild(frag);
  }

  function placeTexts() {
    for (var k in cfg.texts) {
      if (!cfg.texts.hasOwnProperty(k)) continue;
      var t = cfg.texts[k], el = texts[k];
      if (!el) continue;
      el.style.gridColumn = t.c + ' / span ' + t.w;
      el.style.gridRow = t.r + ' / span ' + t.h;
    }
  }

  function makeCluster(slot, key, instant) {
    var fig = document.createElement('figure');
    fig.className = 'pc';
    fig.style.gridColumn = slot.c + ' / span ' + slot.w;
    fig.style.gridRow = slot.r + ' / span ' + slot.h;
    fig.style.setProperty('--fade', rnd(2, 3).toFixed(2) + 's');

    var img = document.createElement('img');
    img.src = '/assets/img/photo-' + key + '.webp';
    img.alt = ALT[key] || '';
    if (instant && eagerCount < 2) {
      img.loading = 'eager';
      img.setAttribute('fetchpriority', 'high');
      eagerCount++;
    } else {
      img.loading = 'lazy';
    }
    fig.appendChild(img);
    layer.appendChild(fig);

    var rec = {
      slot: slot, key: key, el: fig, img: img,
      since: (window.performance ? performance.now() : Date.now()),
      hold: rnd(14000, 22000)
    };
    active.push(rec);

    if (instant || reduce) {
      fig.classList.add('on');
    } else {
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { fig.classList.add('on'); });
      });
    }
    return rec;
  }

  function removeCluster(rec) {
    var i = active.indexOf(rec);
    if (i > -1) active.splice(i, 1);
    rec.el.classList.remove('on');          // швы снова проступают
    setTimeout(function () {
      if (rec.el.parentNode) rec.el.parentNode.removeChild(rec.el);
    }, 3200);
  }

  function addCluster() {
    var cand = openSlots.filter(function (s) { return !slotBusy(s); });
    if (!cand.length) return false;
    var avoid = active.map(function (a) { return a.key; });
    makeCluster(pick(cand), nextKey(avoid), false);
    return true;
  }

  function swapImage(rec) {
    var avoid = active.map(function (a) { return a.key; });
    var key = nextKey(avoid);
    var nimg = document.createElement('img');
    nimg.src = '/assets/img/photo-' + key + '.webp';
    nimg.alt = ALT[key] || '';
    nimg.loading = 'lazy';
    nimg.style.opacity = '0';
    nimg.style.transition = 'opacity ' + rnd(2, 3).toFixed(2) + 's ease-in-out';
    rec.el.appendChild(nimg);
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { nimg.style.opacity = '1'; });
    });
    var old = rec.img;
    setTimeout(function () {
      if (old.parentNode) old.parentNode.removeChild(old);
    }, 3200);
    rec.img = nimg;
    rec.key = key;
    rec.since = (window.performance ? performance.now() : Date.now());
    rec.hold = rnd(14000, 22000);
  }

  // Геологический тик: 1–2 изменения, кластеры держатся 14–22 c
  function tick() {
    var now = (window.performance ? performance.now() : Date.now());
    var elig = active.filter(function (a) { return now - a.since >= a.hold; });
    var n = active.length;
    var ops = 0;

    if (n < cfg.low) {
      if (addCluster()) ops++;
    } else if (n > cfg.high) {
      removeCluster(elig.length ? pick(elig) : pick(active));
      ops++;
    } else if (elig.length) {
      var roll = Math.random();
      if (roll < 0.5) {
        swapImage(pick(elig)); ops++;                    // континент меняет фактуру
      } else if (roll < 0.72 && n > cfg.low) {
        removeCluster(pick(elig)); ops++;                 // расходятся — на миг тёмный провал
      } else if (roll < 0.9 && n < cfg.high) {
        if (addCluster()) ops++; else { swapImage(pick(elig)); ops++; }  // сходятся
      } else {
        swapImage(pick(elig)); ops++;
      }
    }

    // изредка мягкий второй ход — только смена фактуры
    if (ops && Math.random() < 0.22) {
      var now2 = (window.performance ? performance.now() : Date.now());
      var pool = active.filter(function (a) { return now2 - a.since >= a.hold; });
      if (pool.length) swapImage(pick(pool));
    }

    timer = setTimeout(tick, rnd(6500, 10500));
  }

  function teardown() {
    if (timer) { clearTimeout(timer); timer = null; }
    active.forEach(function (a) {
      if (a.el.parentNode) a.el.parentNode.removeChild(a.el);
    });
    active = [];
    bag = [];
    eagerCount = 0;
  }

  function init() {
    teardown();
    isMobile = window.matchMedia('(max-width: 767px)').matches;
    cfg = isMobile ? MOB : DESK;
    buildBase();
    placeTexts();
    openSlots = cfg.slots.filter(textFree);

    var avoid = [];
    cfg.initial.forEach(function (si) {
      var slot = cfg.slots[si];
      var key = nextKey(avoid);
      avoid.push(key);
      makeCluster(slot, key, true);
    });

    if (!reduce) timer = setTimeout(tick, rnd(6000, 9000));
  }

  init();

  if (!reduce) {
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        var m = window.matchMedia('(max-width: 767px)').matches;
        if (m !== isMobile) init();
      }, 300);
    });
  }
})();
</script>
