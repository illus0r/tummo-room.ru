<style>
  /* «Тихая колонная мозаика» — карточки в естественном потоке CSS-колонок.
     Фото-карточка = контейнер с фиксированной пропорцией 2:3 (все фото ровно
     2:3, поэтому высота стабильна и не зависит от того, какой кадр показан —
     масонри не прыгает при кроссфейде). Внутри два наложенных <img>. */
  .mosaic-card {
    display: inline-block;
    width: 100%;
    vertical-align: top;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }

  .photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background-color: #262626; /* neutral-800 — тёмный плейсхолдер, без «дыр» */
  }

  .photo-frame .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* пропорция кадра = пропорции контейнера → без кропа */
    opacity: 0;
    transform: scale(1.02);
    transition: opacity 1200ms ease-in-out, transform 1200ms ease-in-out;
    will-change: opacity, transform;
  }

  .photo-frame .layer.is-on {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-frame .layer {
      transition: none;
      transform: none;
    }
  }
</style>

