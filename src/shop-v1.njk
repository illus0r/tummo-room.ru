<script>
  (function () {
    // Пул кадров для кроссфейда — все 15 фото. Пропорция у всех 2:3, контейнер
    // тоже 2:3, поэтому любой кадр встаёт в любую карточку без обрезки.
    var POOL = [
      'photo-stack', 'photo-tumbler', 'photo-cup', 'photo-table', 'photo-tea',
      'photo-vase', 'photo-knead', 'photo-wedge', 'photo-throw', 'photo-center',
      'photo-portrait', 'photo-doorway', 'photo-sun', 'photo-window', 'photo-hand'
    ];

    var reduceMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduceMedia.matches) return; // застываем на первом кадре

    function shuffle(src) {
      var a = src.slice();
      for (var i = a.length - 1; i > 0; i--) {
        var j = (Math.random() * (i + 1)) | 0;
        var t = a[i]; a[i] = a[j]; a[j] = t;
      }
      return a;
    }
    function rand(min, max) { return min + Math.random() * (max - min); }

    var cards = document.querySelectorAll('[data-photo-card]');

    cards.forEach(function (card) {
      var layers = card.querySelectorAll('.layer');
      if (layers.length < 2) return;

      var start = card.getAttribute('data-frame');
      var playlist = shuffle(POOL.filter(function (n) { return n !== start; }));
      var pos = 0;
      var frontOn = true; // layers[0] сейчас видим
      var last = start;

      function nextName() {
        var name = playlist[pos];
        pos++;
        if (pos >= playlist.length) {
          // новый перемешанный проход, без повтора текущего кадра встык
          playlist = shuffle(POOL.filter(function (n) { return n !== name; }));
          pos = 0;
        }
        return name;
      }

      function tick() {
        var name = nextName();
        last = name;
        var incoming = frontOn ? layers[1] : layers[0];
        var outgoing = frontOn ? layers[0] : layers[1];

        function reveal() {
          incoming.classList.add('is-on');   // opacity 0→1, scale 1.02→1, ~1.2s ease-in-out
          outgoing.classList.remove('is-on');
          frontOn = !frontOn;
        }

        incoming.onload = function () { incoming.onload = null; reveal(); };
        incoming.onerror = function () { incoming.onerror = null; schedule(); };
        incoming.src = '/assets/img/' + name + '.webp';
        if (incoming.complete && incoming.naturalWidth > 0) { incoming.onload = null; reveal(); }

        schedule();
      }

      function schedule() {
        // свой интервал у каждой карточки — 7–12 c, не синхронно
        window.setTimeout(tick, rand(7000, 12000));
      }

      // своя стартовая задержка 0–6 c, чтобы доска дышала вразнобой
      window.setTimeout(schedule, rand(0, 6000));
    });
  })();
</script>
