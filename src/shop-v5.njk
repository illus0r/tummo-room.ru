---
layout: base.njk
title: Керамика ручной работы — Tummo Room
---

{% set linkClass = "underline underline-offset-4 decoration-1 decoration-[#d9c5ae]/40 hover:decoration-[#d9c5ae] transition-colors" %}

<style>
  .quilt-wrap { width: 100%; padding: 0 14px; }
  @media (min-width: 768px) { .quilt-wrap { padding: 0 24px; } }

  .quilt {
    display: grid;
    grid-template-columns: repeat(var(--cols, 12), 1fr);
    grid-template-rows: repeat(var(--rows, 27), var(--ch, 90px));
    gap: 3px;
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    background: #050505;
    box-sizing: border-box;
  }

  .qc {
    position: relative;
    overflow: hidden;
    background: #171717;
  }
  .qc.e2 { background: #1e1e1e; }

  .pc {
    background: #161616;
    opacity: 0;
    transition: opacity .9s ease;
    will-change: opacity;
  }
  .pc.in  { opacity: 1; }
  .pc.out { opacity: 0; }

  .pc .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 38%;
    opacity: 0;
    transition: opacity 1.2s ease;
    will-change: opacity;
  }
  .pc .layer.on { opacity: 1; }

  .tc {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(10px, 1.5vw, 20px);
    background: #171717;
    opacity: 0;
    transition: opacity .9s ease;
  }
  .tc.in { opacity: 1; }
  .tc p {
    font-weight: 300;
    font-size: clamp(.82rem, .52rem + .72vw, 1.03rem);
    line-height: 1.5;
    overflow-wrap: anywhere;
    max-width: 42ch;
  }
  .tc p + p { margin-top: .55em; }
  .tc.tc-list p { font-size: clamp(.78rem, .5rem + .62vw, .95rem); line-height: 1.45; }

  .quilt.boot .pc,
  .quilt.boot .tc,
  .quilt.boot .layer { transition: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .pc, .tc, .pc .layer { transition: none !important; }
  }
</style>

<main class="overflow-x-hidden">

  <header class="w-full px-4 md:px-8 pt-8 md:pt-12 pb-8 md:pb-14">
    <a href="/" class="inline-block">
      <img src="/assets/img/logo-horizontal.svg" alt="Tummo Room" class="h-14 w-auto">
    </a>
  </header>

  <div class="quilt-wrap">
    <div id="quilt" class="quilt boot" aria-label="Керамика ручной работы"></div>
  </div>

  <footer class="w-full px-4 md:px-8 pt-10 md:pt-16 pb-16 md:pb-24">
    <a href="/" class="text-xl md:text-2xl font-light {{ linkClass }}">← На главную</a>
  </footer>

  <!-- Копирайт: пять кусков, живут в текстовых лоскутах, никогда не под фото -->
  <div id="quilt-copy" hidden>
    <div data-k="1">
      <p>Меня зовут Оля. Я делаю чайную керамику руками — в небольшой студии с видом на Волгу. Мне важно, чтобы посуда была тихой: чтобы не спорила с чаем, а помогала вернуться вниманием к себе и к этому моменту.</p>
    </div>
    <div data-k="2">
      <p>Вдохновляюсь природой. Прогулкой по лесу, где хочется остановиться и вдохнуть полной грудью. Корой дерева, игрой теней от листвы на земле, тем, как складываются естественные формы и цвета. Отсюда палитра и силуэты моих пиал.</p>
    </div>
    <div data-k="3">
      <p>В керамике мне ближе всего спокойный цвет, естественные формы и небрежная асимметрия — как у природных фактур. Глина, глазури и жар печи — тоже стихии природы; я лишь помогаю им найти форму, где рукотворное и естественное в балансе. Это посуда для тех, кто умеет замедлиться и заметить красоту мира.</p>
    </div>
    <div data-k="4" class="is-list">
      <p>Купить керамику можно во ВКонтакте — <a href="https://vk.ru/tummo_room" class="{{ linkClass }}">vk.ru/tummo_room</a>. А ещё она есть в чайных:</p>
      <p>Волгоград — <a href="https://teaclouds.ru/" class="{{ linkClass }}">Чайные облака</a>, <a href="https://drakonisoroka.ru/" class="{{ linkClass }}">Дракон и сорока</a>, <a href="https://instagram.com/somely_me" class="{{ linkClass }}">Somely</a></p>
      <p>Санкт-Петербург — <a href="https://vk.ru/tsikadatea" class="{{ linkClass }}">Цикада</a>, <a href="https://чяй.рф/" class="{{ linkClass }}">Чяй</a>, <a href="https://vk.ru/po_putea" class="{{ linkClass }}">По пути</a></p>
      <p>Новосибирск — <a href="https://chajen.ru/" class="{{ linkClass }}">Ча жень</a>, <a href="https://vk.ru/2dragons_tea" class="{{ linkClass }}">Два дракона</a></p>
      <p>Краснодар — <a href="https://koitea.taplink.ws/" class="{{ linkClass }}">Кои</a></p>
    </div>
    <div data-k="5">
      <p>Если вам близок мой стиль, я могу сделать керамику на заказ — для дома или для заведения. Напишите мне: <a href="https://t.me/Librocubic" class="{{ linkClass }}">@Librocubic</a>.</p>
    </div>
  </div>

</main>

<script>
(function () {
  var grid = document.getElementById('quilt');
  var copyRoot = document.getElementById('quilt-copy');
  if (!grid) return;

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var GAP = 3;

  var PHOTOS = [
    { n: 'stack',    alt: 'Руки держат вертикальную стопку из восьми глазурованных пиал' },
    { n: 'tumbler',  alt: 'Две руки держат светлый стакан-волну с потёками глазури' },
    { n: 'cup',      alt: 'Синяя пиала с потёками глазури на подоконнике' },
    { n: 'table',    alt: 'Готовые пиалы на столе, рука тянется за одной' },
    { n: 'tea',      alt: 'Руки с гайванью пересыпают чайный лист в пиалу' },
    { n: 'vase',     alt: 'Сухие полевые травы в рукотворной вазе против света' },
    { n: 'knead',    alt: 'Руки приминают шарик глины на гончарном круге' },
    { n: 'wedge',    alt: 'Мастер в фартуке мнёт глину на доске' },
    { n: 'throw',    alt: 'Мастер вытягивает высокую чашку на гончарном круге' },
    { n: 'center',   alt: 'Руки центруют глину на гончарном круге, вид сбоку' },
    { n: 'portrait', alt: 'Оля смотрит в камеру, за спиной полки с керамикой' },
    { n: 'doorway',  alt: 'Оля в запылённом фартуке стоит в дверном проёме' },
    { n: 'sun',      alt: 'Лицо запрокинуто к солнцу, глаза закрыты' },
    { n: 'window',   alt: 'Золотистый контровой профиль у окна' },
    { n: 'hand',     alt: 'Ладонь в глиняной пыли на плече, тёплый свет' }
  ];
  var ALT = {};
  PHOTOS.forEach(function (p) { ALT[p.n] = p.alt; });
  var COVER_SAFE = { tea:1, knead:1, hand:1, table:1, wedge:1, throw:1, center:1, sun:1, window:1, portrait:1 };

  var DESKTOP = {
    cols: 12, rows: 27, splits: 11, photos: 9,
    freeLo: 12, freeHi: 30, pcLo: 6, pcHi: 10,
    bands: [
      { r: 0,  h: 5, segs: [ {w:4,t:'text',k:1}, {w:3,t:'photo'}, {w:2,t:'empty'}, {w:3,t:'photo'} ] },
      { r: 5,  h: 6, segs: [ {w:4,t:'photo'}, {w:5,t:'text',k:3}, {w:3,t:'photo'} ] },
      { r: 11, h: 5, segs: [ {w:3,t:'photo'}, {w:4,t:'text',k:2}, {w:2,t:'empty'}, {w:3,t:'photo'} ] },
      { r: 16, h: 6, segs: [ {w:3,t:'photo'}, {w:5,t:'text',k:4}, {w:4,t:'photo'} ] },
      { r: 22, h: 5, segs: [ {w:4,t:'photo'}, {w:4,t:'text',k:5}, {w:4,t:'photo'} ] }
    ]
  };
  var MOBILE = {
    cols: 5, rows: 52, splits: 7, photos: 6,
    freeLo: 7, freeHi: 17, pcLo: 4, pcHi: 8,
    bands: [
      { r: 0,  h: 4, segs: [ {w:3,t:'photo'}, {w:2,t:'photo'} ] },
      { r: 4,  h: 5, segs: [ {w:5,t:'text',k:1} ] },
      { r: 9,  h: 4, segs: [ {w:2,t:'empty'}, {w:3,t:'photo'} ] },
      { r: 13, h: 6, segs: [ {w:5,t:'text',k:3} ] },
      { r: 19, h: 4, segs: [ {w:3,t:'photo'}, {w:2,t:'photo'} ] },
      { r: 23, h: 5, segs: [ {w:5,t:'text',k:2} ] },
      { r: 28, h: 4, segs: [ {w:2,t:'photo'}, {w:3,t:'empty'} ] },
      { r: 32, h: 7, segs: [ {w:5,t:'text',k:4} ] },
      { r: 39, h: 4, segs: [ {w:3,t:'photo'}, {w:2,t:'photo'} ] },
      { r: 43, h: 5, segs: [ {w:5,t:'text',k:5} ] },
      { r: 48, h: 4, segs: [ {w:2,t:'photo'}, {w:3,t:'photo'} ] }
    ]
  };

  var cfg, COLS, ROWS;
  var rects = [];
  var nodes = new Map();
  var dirty = new Set();
  var uid = 1;
  var timer = null;

  function pick(a) { return a[(Math.random() * a.length) | 0]; }
  function ri(n) { return (Math.random() * n) | 0; }

  function usedImgs() {
    var s = new Set();
    rects.forEach(function (r) { if (r.type === 'photo' && r.img) s.add(r.img); });
    return s;
  }
  function pickPhoto() {
    var used = usedImgs();
    var free = PHOTOS.filter(function (p) { return !used.has(p.n); });
    var pool = free.length ? free : PHOTOS;
    return pick(pool).n;
  }
  function fitFor(r) {
    if (!r.img || !COVER_SAFE[r.img]) return 'contain';
    if (r.h > r.w && r.w >= 2 && r.h >= 3) return 'cover';
    return 'contain';
  }

  function currentCfg() {
    return window.matchMedia('(max-width: 767px)').matches ? MOBILE : DESKTOP;
  }

  function buildModel() {
    rects = [];
    uid = 1;
    COLS = cfg.cols; ROWS = cfg.rows;
    cfg.bands.forEach(function (band) {
      var c = 0;
      band.segs.forEach(function (seg) {
        rects.push({
          id: uid++, c: c, r: band.r, w: seg.w, h: band.h,
          type: seg.t, locked: seg.t === 'text',
          key: seg.k || null, img: null, fit: 'contain',
          e2: Math.random() < 0.5
        });
        c += seg.w;
      });
    });
    for (var i = 0; i < cfg.splits; i++) trySplit();
    // seed photos
    var empties = rects.filter(function (r) { return !r.locked && r.type === 'empty'; });
    shuffle(empties);
    for (var j = 0; j < cfg.photos && j < empties.length; j++) {
      var r = empties[j];
      r.type = 'photo';
      r.img = pickPhoto();
      r.fit = fitFor(r);
    }
    validate('build');
  }

  function shuffle(a) {
    for (var i = a.length - 1; i > 0; i--) {
      var k = ri(i + 1); var t = a[i]; a[i] = a[k]; a[k] = t;
    }
  }

  function splittable(r) {
    return !r.locked && r.w * r.h >= 4 && (r.w >= 2 || r.h >= 2);
  }

  function replace(remove, add) {
    remove.forEach(function (r) {
      var i = rects.indexOf(r);
      if (i >= 0) rects.splice(i, 1);
    });
    add.forEach(function (r) { rects.push(r); });
  }

  function trySplit() {
    var cands = rects.filter(splittable);
    if (!cands.length) return null;
    var r = pick(cands);
    var horiz;
    if (r.w >= 2 && r.h >= 2) horiz = Math.random() < 0.5;
    else horiz = r.h >= 2;

    var a, b;
    if (horiz) {
      var cutH = 1 + ri(r.h - 1);
      a = mk(r.c, r.r, r.w, cutH);
      b = mk(r.c, r.r + cutH, r.w, r.h - cutH);
    } else {
      var cutW = 1 + ri(r.w - 1);
      a = mk(r.c, r.r, cutW, r.h);
      b = mk(r.c + cutW, r.r, r.w - cutW, r.h);
    }
    a.type = r.type;
    b.type = (Math.random() < 0.5) ? r.type : (r.type === 'photo' ? 'empty' : 'photo');
    [a, b].forEach(function (x) {
      if (x.type === 'photo') { x.img = pickPhoto(); x.fit = fitFor(x); }
    });
    if (r.type === 'photo') { a.img = r.img; a.fit = fitFor(a); }
    replace([r], [a, b]);
    return [a, b];
  }

  function mk(c, r, w, h) {
    return { id: uid++, c: c, r: r, w: w, h: h, type: 'empty',
      locked: false, key: null, img: null, fit: 'contain', e2: Math.random() < 0.5 };
  }

  function mergeCandidates() {
    var res = [];
    for (var i = 0; i < rects.length; i++) {
      var a = rects[i];
      if (a.locked) continue;
      for (var j = 0; j < rects.length; j++) {
        if (j === i) continue;
        var b = rects[j];
        if (b.locked) continue;
        var u = null;
        if (b.c === a.c + a.w && b.r === a.r && b.h === a.h) u = { c: a.c, r: a.r, w: a.w + b.w, h: a.h };
        else if (b.r === a.r + a.h && b.c === a.c && b.w === a.w) u = { c: a.c, r: a.r, w: a.w, h: a.h + b.h };
        if (!u) continue;
        if (u.w > 4 || u.h > 5 || u.w * u.h > 12) continue;
        res.push([a, b, u]);
      }
    }
    return res;
  }

  function tryMerge() {
    var cands = mergeCandidates();
    if (!cands.length) return null;
    var t = pick(cands), a = t[0], b = t[1], u = t[2];
    var m = { id: uid++, c: u.c, r: u.r, w: u.w, h: u.h, type: 'photo',
      locked: false, key: null, img: null, fit: 'contain', e2: false };
    m.img = pickPhoto();
    m.fit = fitFor(m);
    replace([a, b], [m]);
    return m;
  }

  function tryToggle(dir) {
    var cands = rects.filter(function (r) {
      if (r.locked || r.w * r.h > 6) return false;
      if (dir === 'on') return r.type === 'empty';
      if (dir === 'off') return r.type === 'photo';
      return true;
    });
    if (!cands.length) return null;
    var r = pick(cands);
    if (r.type === 'photo') { r.type = 'empty'; r.img = null; }
    else { r.type = 'photo'; r.img = pickPhoto(); r.fit = fitFor(r); }
    dirty.add(r.id);
    return r;
  }

  function trySwap() {
    var cands = rects.filter(function (r) { return !r.locked && r.type === 'photo'; });
    if (!cands.length) return null;
    var r = pick(cands);
    var next = pickPhoto();
    if (next === r.img && PHOTOS.length > 1) next = pickPhoto();
    r.img = next;
    r.fit = fitFor(r);
    dirty.add(r.id);
    return r;
  }

  function tick() {
    var pc = rects.filter(function (r) { return !r.locked && r.type === 'photo'; }).length;
    var free = rects.filter(function (r) { return !r.locked; }).length;
    var op, roll = Math.random();

    if (free > cfg.freeHi) op = 'merge';
    else if (free < cfg.freeLo) op = 'split';
    else if (pc < cfg.pcLo) op = roll < 0.5 ? 'split' : (roll < 0.82 ? 'toggleOn' : 'swap');
    else if (pc > cfg.pcHi) op = roll < 0.5 ? 'merge' : (roll < 0.82 ? 'toggleOff' : 'swap');
    else {
      if (roll < 0.44) op = 'swap';
      else if (roll < 0.64) op = 'split';
      else if (roll < 0.84) op = 'merge';
      else op = 'toggle';
    }

    var done = null;
    if (op === 'swap') done = trySwap();
    else if (op === 'split') done = trySplit();
    else if (op === 'merge') done = tryMerge();
    else if (op === 'toggle') done = tryToggle(null);
    else if (op === 'toggleOn') done = tryToggle('on');
    else if (op === 'toggleOff') done = tryToggle('off');
    if (!done) trySwap();

    validate(op);
    render(false);
    schedule();
  }

  function schedule() {
    timer = setTimeout(tick, 6000 + Math.random() * 4000);
  }

  // ---- rendering ----

  function place(node, r) {
    node.style.gridColumn = (r.c + 1) + ' / span ' + r.w;
    node.style.gridRow = (r.r + 1) + ' / span ' + r.h;
  }

  function makeTextNode(r) {
    var node = document.createElement('div');
    node.className = 'qc tc' + (r.key === 4 ? ' tc-list' : '');
    var src = copyRoot ? copyRoot.querySelector('[data-k="' + r.key + '"]') : null;
    if (src) {
      var clone = src.cloneNode(true);
      clone.removeAttribute('data-k');
      while (clone.firstChild) node.appendChild(clone.firstChild);
    }
    return node;
  }

  function makePhotoNode(r) {
    var node = document.createElement('div');
    node.className = 'qc pc' + (r.e2 ? ' e2' : '');
    var l1 = document.createElement('img');
    var l2 = document.createElement('img');
    l1.className = 'layer'; l2.className = 'layer';
    l1.loading = 'lazy'; l2.loading = 'lazy';
    l1.alt = ''; l2.alt = '';
    node.appendChild(l1); node.appendChild(l2);
    return node;
  }

  function setPhoto(node, r, immediate) {
    var layers = node.querySelectorAll('.layer');
    var onL = node.querySelector('.layer.on');
    var offL;
    if (!onL) { onL = layers[0]; offL = layers[1]; }
    else offL = (onL === layers[0]) ? layers[1] : layers[0];

    var src = '/assets/img/photo-' + r.img + '.webp';
    offL.style.objectFit = r.fit;
    offL.alt = ALT[r.img] || 'Керамика ручной работы';

    if (offL.getAttribute('src') === src) {
      offL.classList.add('on');
      onL.classList.remove('on');
      return;
    }
    var swap = function () {
      offL.classList.add('on');
      onL.classList.remove('on');
    };
    if (immediate) {
      offL.src = src;
      if (offL.complete) swap(); else offL.onload = swap;
    } else {
      offL.onload = swap;
      offL.src = src;
    }
  }

  function clearPhoto(node) {
    node.querySelectorAll('.layer').forEach(function (l) { l.classList.remove('on'); });
  }

  function render(first) {
    grid.style.setProperty('--cols', COLS);
    grid.style.setProperty('--rows', ROWS);

    var modelIds = new Set(rects.map(function (r) { return r.id; }));

    nodes.forEach(function (node, id) {
      if (!modelIds.has(id)) {
        node.classList.add('out');
        node.classList.remove('in');
        var n = node;
        setTimeout(function () { if (n.parentNode) n.parentNode.removeChild(n); }, 950);
        nodes.delete(id);
      }
    });

    rects.forEach(function (r) {
      var node = nodes.get(r.id);
      if (!node) {
        node = (r.type === 'text') ? makeTextNode(r) : makePhotoNode(r);
        nodes.set(r.id, node);
        place(node, r);
        grid.appendChild(node);
        if (r.type === 'photo' && r.img) setPhoto(node, r, true);
        if (reduce || first) {
          node.classList.add('in');
        } else {
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { node.classList.add('in'); });
          });
        }
      } else {
        place(node, r);
        if (dirty.has(r.id)) {
          if (r.type === 'photo' && r.img) setPhoto(node, r, false);
          else if (r.type === 'empty') clearPhoto(node);
        }
      }
    });

    dirty.clear();
    fitCells();
  }

  function fitCells() {
    var inner = grid.clientWidth;
    if (!inner) return;
    var ch = (inner - GAP * (COLS - 1)) / COLS;
    grid.style.setProperty('--ch', ch.toFixed(2) + 'px');
  }

  // ---- validation (dev aid) ----
  function validate(tag) {
    var area = 0;
    for (var i = 0; i < rects.length; i++) {
      var a = rects[i];
      area += a.w * a.h;
      if (a.c < 0 || a.r < 0 || a.c + a.w > COLS || a.r + a.h > ROWS) {
        console.warn('[quilt] out of bounds after ' + tag, a);
      }
      for (var j = i + 1; j < rects.length; j++) {
        var b = rects[j];
        if (a.c < b.c + b.w && b.c < a.c + a.w && a.r < b.r + b.h && b.r < a.r + a.h) {
          console.warn('[quilt] overlap after ' + tag, a, b);
        }
      }
    }
    if (area !== COLS * ROWS) {
      console.warn('[quilt] coverage ' + area + ' != ' + (COLS * ROWS) + ' after ' + tag);
    }
  }

  // ---- boot ----
  function start() {
    cfg = currentCfg();
    buildModel();
    render(true);
    requestAnimationFrame(function () {
      setTimeout(function () { grid.classList.remove('boot'); }, 40);
    });
    if (!reduce) schedule();
  }

  var rt;
  window.addEventListener('resize', function () {
    clearTimeout(rt);
    rt = setTimeout(function () {
      var next = currentCfg();
      if (next !== cfg) {
        if (timer) clearTimeout(timer);
        nodes.forEach(function (n) { if (n.parentNode) n.parentNode.removeChild(n); });
        nodes.clear();
        dirty.clear();
        cfg = next;
        grid.classList.add('boot');
        buildModel();
        render(true);
        setTimeout(function () { grid.classList.remove('boot'); }, 40);
        if (!reduce) schedule();
      } else {
        fitCells();
      }
    }, 250);
  });

  start();
})();
</script>
