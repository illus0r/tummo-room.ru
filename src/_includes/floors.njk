---
layout: base.njk
---
{#- Страница «этажами»: абзацы с атрибутом data-txt, между ними места под фото на телефоне (fl-slot).
    Фоны и фото — photos[photoSet] из src/_data/photos.js, логика — /assets/js/floors.js -#}
<link rel="stylesheet" href="/assets/css/floors.css">

<main class="fl" id="fl">
  <a href="/" class="fl-logo" id="fl-logo">
    <img src="/assets/img/logo-horizontal.svg" alt="Туммо">
  </a>

  {#- heading задаётся в начале страницы; <br> в нём — там, где перенос нужен по смыслу -#}
  <h1 class="fl-title" id="fl-title">{{ heading | safe }}</h1>

  {{ content | safe }}

  <footer class="fl-footer" id="fl-footer">
    <div>
      <h3>Страницы</h3>
      <nav>
        <a href="/">Главная</a>
        <a href="/ceramics/">Моя керамика</a>
        <a href="/workshops/">Мастер-классы и коворкинг</a>
      </nav>
    </div>
    <div>
      <h3>Связь</h3>
      <nav>
        <a href="https://vk.ru/tummo_room">ВКонтакте</a>
        <a href="https://t.me/tummo_room">Telegram</a>
        <a href="tel:+79884931362">+7 (988) 493-13-62</a>
      </nav>
    </div>
    <div class="fl-legal">
      <h3>Реквизиты</h3>
      <div>Соболева Ольга Олеговна</div>
      <div>Самозанятая</div>
      <div>ИНН 541500840873</div>
    </div>
  </footer>
</main>

<script>window.PHOTOS = {{ photos[photoSet] | dump | safe }};</script>
<script src="/assets/js/floors.js"></script>
{%- if photoSet == "ceramics" %}
<script>window.GALLERY = {{ photos.gallery | dump | safe }};</script>
<script src="/assets/js/gallery.js"></script>
{%- endif %}
